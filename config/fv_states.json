
{
  "model": "ventricular_fibrillation_monitoring",
  "version": "0.2.0",
  "purpose": "simulation_only",
  "state_field_order": [
    "heart_rate_status",
    "spo2_status",
    "respiratory_rate_status",
    "blood_pressure_status",
    "ecg_quality",
    "rhythm_classification",
    "qrs_status",
    "pulse_status",
    "responsiveness_status",
    "breathing_status"
  ],
  "notes": [
    "Every value in a state profile is an atomic category or an explicit not_assessed category.",
    "A state profile describes evidence expected for that state; it does not infer missing measurements.",
    "VF_CARDIAC_ARREST requires independent clinical evidence in addition to ECG evidence."
  ],

  "states": {
    "NORMAL_MONITORING": {
      "heart_rate_status": "normal_for_context",
      "spo2_status": "adequate",
      "respiratory_rate_status": "normal_for_context",
      "blood_pressure_status": "stable",
      "ecg_quality": "valid",
      "rhythm_classification": "normal_sinus",
      "qrs_status": "organized",
      "pulse_status": "present",
      "responsiveness_status": "responsive",
      "breathing_status": "normal"
    },

    "ABNORMAL_RHYTHM": {
      "heart_rate_status": "not_assessed",
      "spo2_status": "not_assessed",
      "respiratory_rate_status": "not_assessed",
      "blood_pressure_status": "not_assessed",
      "ecg_quality": "valid",
      "rhythm_classification": "abnormal_non_vf",
      "qrs_status": "abnormal",
      "pulse_status": "present",
      "responsiveness_status": "responsive",
      "breathing_status": "normal"
    },

    "SUSPECTED_VF": {
      "heart_rate_status": "not_reliably_calculable",
      "spo2_status": "potentially_unreliable",
      "respiratory_rate_status": "not_assessed",
      "blood_pressure_status": "not_assessed",
      "ecg_quality": "valid",
      "rhythm_classification": "vf_compatible",
      "qrs_status": "not_organized",
      "pulse_status": "not_assessed",
      "responsiveness_status": "not_assessed",
      "breathing_status": "not_assessed"
    },

    "VF_CARDIAC_ARREST": {
      "heart_rate_status": "not_reliably_calculable",
      "spo2_status": "unreliable_without_perfusion",
      "respiratory_rate_status": "not_assessed",
      "blood_pressure_status": "unmeasurable",
      "ecg_quality": "valid",
      "rhythm_classification": "vf_compatible",
      "qrs_status": "not_organized",
      "pulse_status": "absent",
      "responsiveness_status": "unresponsive",
      "breathing_status": "absent"
    },

    "SIGNAL_INVALID": {
      "heart_rate_status": "unreliable",
      "spo2_status": "not_assessed",
      "respiratory_rate_status": "not_assessed",
      "blood_pressure_status": "not_assessed",
      "ecg_quality": "invalid",
      "rhythm_classification": "uninterpretable",
      "qrs_status": "uninterpretable",
      "pulse_status": "not_assessed",
      "responsiveness_status": "not_assessed",
      "breathing_status": "not_assessed"
    }
  }
}

